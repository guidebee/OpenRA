{
	"version": "2.0.0",
	"options": {
		"env": {
			"ENGINE_DIR": ".."
		}
	},
	"tasks": [
		{
			"label": "build",
			"command": "make",
			"args": ["all", "CONFIGURATION=Debug"],
			"windows": {
				"command": "make.cmd"
			}
		},
		{
			"label": "Run Utility",
			"command": "dotnet ${workspaceRoot}/bin/OpenRA.Utility.dll ${input:modId} ${input:command}",
			"type": "shell",
		},
		{
			"label": "Run Template Reader",
			"command": "dotnet ${workspaceRoot}/bin/OpenRA.TemplateReader.dll --tileset ${input:tileset} --template-id ${input:templateId} --mod ${input:modId} --game-path ${workspaceRoot}",
			"type": "shell",
			"group": "build",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "modId",
			"description": "ID of the mod to run",
			"default": "ra",
			"type": "promptString"
		},
		{
			"id": "command",
			"description": "Name of the command + parameters",
			"default": "",
			"type": "promptString"
		},
		{
			"id": "tileset",
			"description": "Tileset name (e.g., temperat, desert, snow)",
			"default": "temperat",
			"type": "promptString"
		},
		{
			"id": "templateId",
			"description": "Template ID to export",
			"default": "401",
			"type": "promptString"
		}
	]
}
